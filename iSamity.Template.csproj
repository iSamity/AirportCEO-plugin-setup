<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>iSamity.Template</PackageId>
    <PackageVersion>1.0.0</PackageVersion>
    <Authors>iSamity</Authors>
    <Description>dotnet new template for BepInEx 5 plugins targeting Airport CEO (Unity 2019.4 / net46).</Description>
    <PackageTags>dotnet-new;templates;BepInEx;AirportCEO</PackageTags>
    <TargetFramework>net8.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <!-- NU5128: template layout; NU5100: Libs/*.dll are template content, not package lib references -->
    <NoWarn>$(NoWarn);NU5128;NU5100;NU5110;NU5111</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="content\**\*" Exclude="content\**\bin\**;content\**\obj\**" Pack="true" PackagePath="content/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Remove="**\*" />
  </ItemGroup>

</Project>
