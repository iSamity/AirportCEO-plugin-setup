<Project Sdk="Microsoft.NET.Sdk">



  <PropertyGroup>

    <PackageType>Template</PackageType>

    <PackageId>iSamity.Template</PackageId>

    <PackageVersion>1.0.3</PackageVersion>

    <Authors>iSamity</Authors>

    <Copyright>Copyright (c) iSamity 2026</Copyright>

    <Title>ModTemplates</Title>

    <Description>ModTemplates — dotnet new template pack for BepInEx 5 plugins targeting Airport CEO (Unity 2019.4 / net46).</Description>

    <PackageTags>dotnet-new;templates;templatepack;BepInEx;AirportCEO;Airport CEO;mod;Unity;plugin;net46</PackageTags>

    <PackageReadmeFile>README.md</PackageReadmeFile>

    <PackageProjectUrl>https://github.com/iSamity/AirportCEO-plugin-setup</PackageProjectUrl>

    <RepositoryUrl>https://github.com/iSamity/AirportCEO-plugin-setup.git</RepositoryUrl>

    <RepositoryType>git</RepositoryType>

    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <TargetFramework>net8.0</TargetFramework>

    <IncludeContentInPack>true</IncludeContentInPack>

    <IncludeBuildOutput>false</IncludeBuildOutput>

    <NoDefaultExcludes>true</NoDefaultExcludes>

    <!-- NU5128: template layout; NU5100: Libs/*.dll are template content, not package lib references -->

    <NoWarn>$(NoWarn);NU5128;NU5100;NU5110;NU5111</NoWarn>

  </PropertyGroup>



  <ItemGroup>

    <Content Include="content\**\*" Exclude="content\**\bin\**;content\**\obj\**" Pack="true" PackagePath="content/%(RecursiveDir)%(Filename)%(Extension)" />

    <None Include="README.md" Pack="true" PackagePath="\" />

    <Compile Remove="**\*" />

  </ItemGroup>



</Project>

